---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

// Filter posts by category
const reconstitutionPosts = posts.filter(
  (post) => post.data.category === "Preparation & Reconstitution"
);
---

<BaseLayout>
  <main>
    <h1>Preparation & Reconstitution</h1>

    <p>
      Educational resources explaining how peptide reconstitution is commonly
      discussed in research contexts, including preparation concepts, commonly
      referenced supplies, and safety considerations.
    </p>

    <ul>
      {reconstitutionPosts.map((post) => (
        <li>
          <h2>
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
